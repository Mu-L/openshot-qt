#: ../effects.rst:1671
msgid ":guilabel:`Start Time` offsets count-up, clock, timecode, frame, and count-down values."
msgstr ""

#: ../effects.rst:1672
msgid ":guilabel:`Gravity` places the timer in one of nine positions on the frame."
msgstr ""

#: ../effects.rst:1673
msgid ":guilabel:`X Offset (%)` and :guilabel:`Y Offset (%)` move the timer by a percentage of the frame size."
msgstr ""

