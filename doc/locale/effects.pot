msgid "low_color"
msgstr ""

#: ../effects.rst:589
msgid "``(color)`` Color generated when the audio response is low. The default is black."
msgstr ""

#: ../effects.rst:590
msgid "high_color"
msgstr ""

#: ../effects.rst:590
msgid "``(color)`` Color generated when the audio response is high. The default is white."
msgstr ""

#: ../effects.rst:591
msgid "``(float, 0 to 10)`` Audio gain before response shaping. Higher values make quieter audio produce stronger flashes."
msgstr ""

#: ../effects.rst:592
